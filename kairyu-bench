#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IMAGE=${KAIRYU_BENCH_IMAGE:-kairyu-bench:local}
RESULTS_DIR=$ROOT/results
CACHE_DIR=${KAIRYU_BENCH_CACHE_DIR:-$ROOT/.cache}
DOCKER_SOCKET=${KAIRYU_BENCH_DOCKER_SOCKET:-/var/run/docker.sock}
# The calling directory is mounted at its own path and is the container's
# working directory, so relative paths in arguments (manifests, result
# directories to compare) read and write the host's files.
CALLER_DIR=$(pwd -P)

command -v docker >/dev/null 2>&1 || {
    echo "kairyu-bench: Docker is required" >&2
    exit 2
}

mkdir -p "$RESULTS_DIR" "$CACHE_DIR"
[ -S "$DOCKER_SOCKET" ] || {
    echo "kairyu-bench: Docker socket not found: $DOCKER_SOCKET" >&2
    exit 2
}

docker build -t "$IMAGE" "$ROOT"

# KAIRYU_BENCH_DOCKER_NETWORK joins the runner to a Docker network, e.g. a
# served model's compose network so `wsp run --logprob-endpoint` reaches its
# vLLM replicas directly.
exec docker run --rm --privileged \
    ${KAIRYU_BENCH_DOCKER_NETWORK:+--network "$KAIRYU_BENCH_DOCKER_NETWORK"} \
    --add-host host.docker.internal:host-gateway \
    -v "$DOCKER_SOCKET:/var/run/docker.sock" \
    -v "$CALLER_DIR:$CALLER_DIR" \
    -w "$CALLER_DIR" \
    -v "$RESULTS_DIR:$RESULTS_DIR" \
    -v "$CACHE_DIR:$CACHE_DIR" \
    -e "KAIRYU_BENCH_RESULTS_DIR=$RESULTS_DIR" \
    -e "KAIRYU_BENCH_CACHE_DIR=$CACHE_DIR" \
    -e "KAIRYU_BENCH_CLEAN_TASK_IMAGES=${KAIRYU_BENCH_CLEAN_TASK_IMAGES:-0}" \
    -e "KAIRYU_BENCH_LIVECODEBENCH_PRO_RETRIES=${KAIRYU_BENCH_LIVECODEBENCH_PRO_RETRIES:-3}" \
    -e "KAIRYU_BENCH_LIVECODEBENCH_PRO_WORKERS=${KAIRYU_BENCH_LIVECODEBENCH_PRO_WORKERS:-4}" \
    -e "KAIRYU_BENCH_SWEBENCH_PRO_WORKERS=${KAIRYU_BENCH_SWEBENCH_PRO_WORKERS:-4}" \
    -e "KAIRYU_BENCH_TERMINAL_BENCH_WORKERS=${KAIRYU_BENCH_TERMINAL_BENCH_WORKERS:-4}" \
    -e "KAIRYU_BENCH_TERMINAL_BENCH_SETUP_TIMEOUT_MULTIPLIER=${KAIRYU_BENCH_TERMINAL_BENCH_SETUP_TIMEOUT_MULTIPLIER:-4}" \
    -e "KAIRYU_BENCH_DEEPSWE_WORKERS=${KAIRYU_BENCH_DEEPSWE_WORKERS-4}" \
    -e "KAIRYU_BENCH_DEEPSWE_ATTEMPTS=${KAIRYU_BENCH_DEEPSWE_ATTEMPTS-1}" \
    -e "KAIRYU_BENCH_DEEPSWE_RETRIES=${KAIRYU_BENCH_DEEPSWE_RETRIES-3}" \
    -e KAIRYU_BENCH_DEEPSWE_REASONING_EFFORT \
    -e KAIRYU_BENCH_DEEPSWE_API_TIMEOUT_SECONDS \
    -e KAIRYU_BENCH_DEEPSWE_TASKS \
    -e KAIRYU_BENCH_TERMINAL_BENCH_TASKS \
    -e KAIRYU_BENCH_SWEBENCH_PRO_INSTANCES \
    -e KAIRYU_BENCH_DEEPSWE_AGENT \
    -e KAIRYU_BENCH_DEEPSWE_CONTEXT_WINDOW \
    -e KAIRYU_BENCH_DEEPSWE_MAX_TOKENS \
    -e "KAIRYU_BENCH_TERMINAL_BENCH_4_WORKERS=${KAIRYU_BENCH_TERMINAL_BENCH_4_WORKERS-4}" \
    -e "KAIRYU_BENCH_TERMINAL_BENCH_4_ATTEMPTS=${KAIRYU_BENCH_TERMINAL_BENCH_4_ATTEMPTS-1}" \
    -e "KAIRYU_BENCH_TERMINAL_BENCH_4_RETRIES=${KAIRYU_BENCH_TERMINAL_BENCH_4_RETRIES-3}" \
    -e KAIRYU_BENCH_TERMINAL_BENCH_4_REASONING_EFFORT \
    -e "KAIRYU_LIGHTCPVERIFIER_HOST=${KAIRYU_LIGHTCPVERIFIER_HOST:-container}" \
    -e KAIRYU_API_KEY \
    -e HF_TOKEN \
    "$IMAGE" "$@"
